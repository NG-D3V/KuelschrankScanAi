rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Household Groups (accessible by group ID)
    match /groups/{groupId} {
      allow read, write: if true;

      // Items within a Group
      match /items/{itemId} {
        allow read, write: if true;
      }
    }
  }
}

